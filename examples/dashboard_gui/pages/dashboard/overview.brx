
type MetricCard =
    title: str
    value: str
    change: str
    is_positive = true

type ActivityLog =
    id: int
    timestamp: str
    action: str
    status: str

type OverviewPage =
    title = "Cluster Overview"
    subtitle = "Real-time aggregate of all regions"
    refresh_interval = 30
    search_query = ""

    metrics: [MetricCard] = [
        MetricCard(title = "Total API Requests", value = "128,450", change = "+14.2%", is_positive = true),
        MetricCard(title = "Avg Latency", value = "24.5 ms", change = "-3.1 ms", is_positive = true),
        MetricCard(title = "Error Rate", value = "0.04%", change = "-3.1%", is_positive = true),
        MetricCard(title = "Memory Utilization", value = "68%", change = "+2.4%", is_positive = false)
    ]

    activities: [ActivityLog] = [
        ActivityLog(id = 1, timestamp = "12:45:10", action = "Auto-scaled cluster workers +2", status = "Success"),
        ActivityLog(id = 2, timestamp = "12:43:02", action = "Database read-replica synced", status = "Success"),
        ActivityLog(id = 3, timestamp = "12:40:55", action = "TLS certificate auto-renewed", status = "Success"),
        ActivityLog(id = 4, timestamp = "12:38:12", action = "Node-04 high memory alert cleared", status = "Resolved")
    ]

    refresh() =>
        title = "Cluster Overview"

    simulate_traffic() =>
        activities.push(ActivityLog(id = 99, timestamp = "now", action = "Manual load simulation", status = "Success"))

    clear_activities() =>
        activities = []

view OverviewPage =>
    <Panel class="screen">
        <Col class="card">
            <Text class="card_title">{title}</Text>
            <Text class="card_subtitle">{subtitle}</Text>
            <Row class="form_row">
                <Input class="input_field" bind={search_query} placeholder="Search metrics or logs..." />
                <Button class="btn_primary" onClick={simulate_traffic()}>
                    Simulate
                </Button>
            </Row>
            <Row class="slider_row">
                <Text class="slider_label">Refresh every {refresh_interval}s</Text>
                <Slider bind={refresh_interval} />
            </Row>
            <Row class="kpi_grid">
                {for card in metrics =>
                    {if raw_rust { self.search_query.is_empty() || card.title.contains(self.search_query.as_str()) } =>
                        <Col class="kpi_card">
                            <Text class="kpi_title">{card.title}</Text>
                            <Text class="kpi_value">{card.value}</Text>
                            <Text class="kpi_change">{card.change}</Text>
                        </Col>
                    }
                }
            </Row>
            <Row class="section_header">
                <Text class="section_title">Aggregates</Text>
                <Button class="btn_secondary" onClick={refresh()}>
                    Refresh
                </Button>
                <Button class="btn_secondary" onClick={clear_activities()}>
                    Clear
                </Button>
            </Row>
            <Scroll class="log_scroll">
                <Col class="log_list">
                    {for item in activities =>
                        {if raw_rust { self.search_query.is_empty() || item.action.contains(self.search_query.as_str()) } =>
                            <Row class="log_row">
                                <Text class="log_time">[{item.timestamp}]</Text>
                                <Text class="log_action">{item.action}</Text>
                                <Text class="log_status">{item.status}</Text>
                            </Row>
                        }
                    }
                </Col>
            </Scroll>
        </Col>
    </Panel>
