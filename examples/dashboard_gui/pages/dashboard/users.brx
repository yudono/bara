
type ClusterNode =
    id: int
    name: str
    status = "healthy"

type UsersPage =
    title = "Cluster Nodes"
    filter = ""
    node_name = ""
    node_status = "healthy"
    node_error = ""
    editing_id: int = 0
    next_node_id: int = 6

    users: [ClusterNode] = [
        ClusterNode(id = 1, name = "web-01", status = "healthy"),
        ClusterNode(id = 2, name = "web-02", status = "healthy"),
        ClusterNode(id = 3, name = "worker-01", status = "healthy"),
        ClusterNode(id = 4, name = "worker-02", status = "degraded"),
        ClusterNode(id = 5, name = "db-primary", status = "healthy")
    ]

    add_or_save() =>
        if node_name == "" =>
            node_error = "Node name is required"
            return
        if editing_id == 0 =>
            users.push(ClusterNode(id = next_node_id, name = node_name, status = node_status))
            next_node_id = next_node_id + 1
            node_error = ""
            node_name = ""
        else =>
            i = 0
            found = -1
            while i < users.len() =>
                if users[i].id == editing_id =>
                    found = i
                i = i + 1
            if found != -1 =>
                users[found] = ClusterNode(id = editing_id, name = node_name, status = node_status)
                node_error = ""
                editing_id = 0
                node_name = ""
                node_status = "healthy"
            else =>
                node_error = "Node not found"

    edit_user(id: int) =>
        i = 0
        while i < users.len() =>
            if users[i].id == id =>
                editing_id = id
                node_name = users[i].name.clone()
                node_status = users[i].status.clone()
                node_error = ""
            i = i + 1

    cancel_edit() =>
        editing_id = 0
        node_name = ""
        node_status = "healthy"
        node_error = ""

    remove_user(id: int) =>
        users.retain(u => u.id != id)
        if editing_id == id =>
            editing_id = 0
            node_name = ""

view UsersPage =>
    <Panel class="screen">
        <Col class="card">
            <Text class="card_title">{title}</Text>
            <Text class="card_subtitle">Every node in the fleet at a glance</Text>
            <Col class="form_box">
                <Input class="input_field" bind={node_name} placeholder="Node name (e.g. web-03)" />
                <Row class="form_row">
                    <Button class={node_status == "healthy" ? "tab_item tab_active" : "tab_item"} onClick={node_status = "healthy"}>
                        Healthy
                    </Button>
                    <Button class={node_status == "degraded" ? "tab_item tab_active" : "tab_item"} onClick={node_status = "degraded"}>
                        Degraded
                    </Button>
                    <Button class={node_status == "down" ? "tab_item tab_active" : "tab_item"} onClick={node_status = "down"}>
                        Down
                    </Button>
                </Row>
                {if editing_id == 0 =>
                    <Button class="btn_primary" onClick={add_or_save()}>
                        Add Node
                    </Button>
                else =>
                    <Row class="form_row">
                        <Button class="btn_primary" onClick={add_or_save()}>
                            Save Changes
                        </Button>
                        <Button class="btn_secondary" onClick={cancel_edit()}>
                            Cancel
                        </Button>
                    </Row>
                }
                {if node_error != "" =>
                    <Text class="status_err">{node_error}</Text>
                }
            </Col>
            <Row class="form_row">
                <Button class={filter == "" ? "tab_item tab_active" : "tab_item"} onClick={filter = ""}>
                    All
                </Button>
                <Button class={filter == "healthy" ? "tab_item tab_active" : "tab_item"} onClick={filter = "healthy"}>
                    Healthy
                </Button>
                <Button class={filter == "degraded" ? "tab_item tab_active" : "tab_item"} onClick={filter = "degraded"}>
                    Degraded
                </Button>
                <Button class={filter == "down" ? "tab_item tab_active" : "tab_item"} onClick={filter = "down"}>
                    Down
                </Button>
            </Row>
            <Scroll class="log_scroll">
                <Col class="log_list">
                    {for u in users =>
                        {if filter == "" or u.status == filter =>
                            <Row class="user_row">
                                <Text class="user_name">{u.name}</Text>
                                <Text class="log_status">{u.status}</Text>
                                <Button class="btn_secondary" onClick={edit_user(u.id)}>
                                    Edit
                                </Button>
                                <Button class="btn_danger" onClick={remove_user(u.id)}>
                                    Remove
                                </Button>
                            </Row>
                        }
                    }
                </Col>
            </Scroll>
        </Col>
    </Panel>
